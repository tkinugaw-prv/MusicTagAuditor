<Window x:Class="MusicTagAuditor.App.AlbumOverrideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MusicTagAuditor.App.Converters"
        xmlns:ctl="clr-namespace:MusicTagAuditor.App.Controls"
        Title="このアルバムの扱いを決める" Height="620" Width="760"
        Icon="/Assets/app_icon.ico"
        Background="{StaticResource BgOuterBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBooleanConverter x:Key="InverseBool" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
  </Window.Resources>

  <DockPanel Margin="18">

    <!-- フォルダと disc は明細から自動で埋める（docs/SPEC.md 7.3.2）。手打ちさせない -->
    <Border DockPanel.Dock="Top" Style="{StaticResource CardBorderStyle}" Padding="14,12">
      <StackPanel>
        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,5,0,0"
                   Text="{Binding ComposersText}" TextWrapping="Wrap" />
        <!-- 年が割れているときだけ出す。一意なら判断材料にならない -->
        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,5,0,0"
                   Text="{Binding DatesText}" TextWrapping="Wrap"
                   Visibility="{Binding HasSplitDates, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Style="{StaticResource NoticePanelBorderStyle}" Padding="14,12" Margin="0,10,0,0">
      <TextBlock Style="{StaticResource NoticeItemTextStyle}" Margin="0" Text="{Binding Notice}" />
    </Border>

    <Border DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="キャンセル" Click="OnCancel" IsCancel="True" Margin="0,0,10,0" />
        <Button Content="辞書に追加して再検査" Click="OnAccept" IsDefault="True"
                Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
      <StackPanel Margin="0,0,8,0">

        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="この単位の扱い" />
        <!--
          年の割れで開いたときは対象外を選ばせない（AlbumOverrideViewModel.CanExclude）。
          そこまで来た単位は作品が決まっている＝主作品が定まっているので規則6 ではなく、
          選べるままだとタグが割れた単位を検出から消すだけの操作になる。
        -->
        <RadioButton GroupName="Mode" IsChecked="{Binding Excludes}"
                     IsEnabled="{Binding CanExclude}"
                     ToolTipService.ShowOnDisabled="True"
                     ToolTip="この単位は作品が決まっているので、対象外（規則6）には当たりません"
                     Content="アルバム名の対象外にする（本物のコンピレーション。3.5 規則6）" />
        <RadioButton GroupName="Mode" Margin="0,8,0,10"
                     IsChecked="{Binding Excludes, Converter={StaticResource InverseBool}}"
                     Content="作曲家・作品名・年を指定する（版の違い 規則4 / 主作品 + カップリング 規則5・規則2 / 同一演奏の別リリース 規則7）" />

        <!-- 上書きの指定。対象外を選んでいる間は出さない -->
        <StackPanel Visibility="{Binding Excludes, Converter={StaticResource InverseBoolToVisibility}}">
          <TextBlock Style="{StaticResource SectionLabelStyle}" Margin="0,10,0,4"
                     Text="作曲家（主作品の作曲家。指定しないなら空のまま）" />
          <ComboBox ItemsSource="{Binding Composers}" SelectedItem="{Binding Composer}" IsEditable="False" />

          <TextBlock Style="{StaticResource SectionLabelStyle}" Margin="0,12,0,4"
                     Text="作品名（この単位だけの作品名。指定しないなら空のまま）" />
          <TextBox ctl:Placeholder.Text="Symphony No. 5 (Olympia) のように書く"
                   Text="{Binding WorkName, UpdateSourceTrigger=PropertyChanged}" />

          <!--
            年は単位内にある値からしか選ばせない（IsEditable="False"）。手で打てると、
            どのファイルにも入っていない年を書けてしまう。ここで選ぶのは「主作品の録音年は
            どれか」であって年の入力ではない。年が割れていない単位では出す意味がない。
          -->
          <StackPanel Visibility="{Binding HasSplitDates, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource SectionLabelStyle}" Margin="0,12,0,4"
                       Text="年（主作品の録音年。指定しないなら空のまま）" />
            <ComboBox ItemsSource="{Binding Dates}" SelectedItem="{Binding Date}" IsEditable="False" />
          </StackPanel>
        </StackPanel>

        <TextBlock Style="{StaticResource SectionLabelStyle}" Margin="0,16,0,4" Text="適用する範囲" />
        <CheckBox IsChecked="{Binding AppliesToWholeFolder}"
                  Content="このフォルダの全ディスクに適用する（disc を空にする）" />

        <!-- 理由の無い例外は、後から消してよいか判断できない（docs/SPEC.md 7.4.5） -->
        <TextBlock Style="{StaticResource SectionLabelStyle}" Margin="0,16,0,4" Text="理由（必須）" />
        <TextBox Height="90" TextWrapping="Wrap"
                 Style="{StaticResource DarkMultilineTextBoxStyle}"
                 ctl:Placeholder.Text="3.5 規則6 コンピレーション のように、どの規則で例外にしたのかを書く"
                 Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="登録して再検査すると、この単位は R-504 の一覧から消えます（対象外にした場合）。フォルダは検査結果から埋めているので、手で打ち直す必要はありません。" />

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
