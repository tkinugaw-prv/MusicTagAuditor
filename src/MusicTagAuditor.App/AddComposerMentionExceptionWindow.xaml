<Window x:Class="MusicTagAuditor.App.AddComposerMentionExceptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:MusicTagAuditor.App.Controls"
        Title="この語句を例外に登録" Height="520" Width="680"
        Icon="/Assets/app_icon.ico"
        Background="{StaticResource BgOuterBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <DockPanel Margin="18">

    <!-- 作曲家は明細から固定で埋める（docs/SPEC.md 7.3.2）。選び直させない -->
    <Border DockPanel.Dock="Top" Style="{StaticResource CardBorderStyle}" Padding="14,12">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
          <Run Text="作曲家: " /><Run Text="{Binding Composer, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,5,0,0" TextWrapping="Wrap">
          <Run Text="ファイル名: " /><Run Text="{Binding FileName, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,5,0,0" TextWrapping="Wrap">
          <Run Text="曲名: " /><Run Text="{Binding Title, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Style="{StaticResource NoticePanelBorderStyle}" Padding="14,12" Margin="0,10,0,0">
      <TextBlock Style="{StaticResource NoticeItemTextStyle}" Margin="0" ctl:PolicyText.Text="{Binding Notice}" />
    </Border>

    <Border DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="キャンセル" Click="OnCancel" IsCancel="True" Margin="0,0,10,0" />
        <Button Content="辞書に追加して再検査" Click="OnAccept" IsDefault="True"
                Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
      <StackPanel Margin="0,0,8,0">
        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="照合から外す語句" />
        <TextBox ctl:Placeholder.Text="Szene am Bach のように、作品の語句だけを書く"
                 Text="{Binding Phrase, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="番号など録音ごとに違う部分は省くと、同じ曲の別の録音にも効きます。大小文字と区切り記号の違いは同じものとして扱います。" />

        <!-- 理由の無い例外は、後から消してよいか判断できない -->
        <TextBlock Style="{StaticResource SectionLabelStyle}" Margin="0,16,0,4" Text="理由（必須）" />
        <TextBox Height="80" TextWrapping="Wrap"
                 Style="{StaticResource DarkMultilineTextBoxStyle}"
                 ctl:Placeholder.Text="交響曲第6番 第2楽章の表題。Bach は普通名詞（小川） のように書く"
                 Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap"
                   ctl:PolicyText.Text="R-210 の判定にだけ使います（TAGGING_POLICY 6.9）。タグは書き換えません。誤って登録した場合は、辞書タブの「語句の例外」から削除すると検出が戻ります。" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
