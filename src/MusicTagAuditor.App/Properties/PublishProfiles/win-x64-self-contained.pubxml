<?xml version="1.0" encoding="utf-8"?>
<!-- 配布用: 自己完結型の単一 exe（.NET ランタイム同梱、実行側に .NET 不要） -->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WPF のネイティブ DLL（wpfgfx 等）も exe に同梱する（初回起動時に一時フォルダーへ展開） -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 管理アセンブリも実体ファイルとして展開する。
         これが false だと TagLibSharp の Assembly.Location が空になり、
         バックアップに復元スクリプト用の TagLibSharp.dll を同梱できない
         （TagWriter.GetPortableLibraryPath / docs/DEVELOPMENT.md「バックアップと復元」）。 -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishDir>bin\publish\win-x64-self-contained\</PublishDir>
  </PropertyGroup>
</Project>
