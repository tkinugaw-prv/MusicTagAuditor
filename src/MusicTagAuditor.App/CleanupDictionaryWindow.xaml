<Window x:Class="MusicTagAuditor.App.CleanupDictionaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="冗長な別名を掃除する" Height="620" Width="900"
        Icon="/Assets/app_icon.ico"
        Background="{StaticResource BgOuterBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <DockPanel Margin="18">

    <Border DockPanel.Dock="Top" Style="{StaticResource CardBorderStyle}" Padding="14,12">
      <StackPanel>
        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Text="辞書の照合は、大文字小文字・記号・ダイアクリティカルマーク・濁点を落とした正規化キーで行います。キーが同じ別名は先に書いたほうだけが索引に載るため、下の別名は書いてあっても引かれていません。" />
        <TextBlock Style="{StaticResource NoticeItemTextStyle}" Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Text="削除しても引ける値は変わりません。残る名前で今までどおり引けます。正規形と時代分割の名前は削除しません。" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="キャンセル" Click="OnCancel" IsCancel="True" Margin="0,0,10,0" />
        <Button Content="掃除して保存" Click="OnAccept" IsDefault="True"
                Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource CardBorderStyle}" Padding="1" Margin="0,16,0,0">
      <DataGrid ItemsSource="{Binding Items}" CanUserSortColumns="True" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="種別" Width="70"
                              Binding="{Binding Category}"
                              ElementStyle="{StaticResource CenterCellTextStyle}" />
          <DataGridTextColumn Header="エントリ" Width="2*"
                              Binding="{Binding Owner}"
                              ElementStyle="{StaticResource EllipsisTextStyle}" />
          <DataGridTextColumn Header="削除する別名" Width="*"
                              Binding="{Binding Name}"
                              ElementStyle="{StaticResource EllipsisTextStyle}" />
          <DataGridTextColumn Header="残る名前" Width="*"
                              Binding="{Binding KeptName}"
                              ElementStyle="{StaticResource EllipsisTextStyle}" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</Window>
