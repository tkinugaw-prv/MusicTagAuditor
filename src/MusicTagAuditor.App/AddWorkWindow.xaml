<Window x:Class="MusicTagAuditor.App.AddWorkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:MusicTagAuditor.App.Controls"
        Title="作品を辞書に追加" Height="620" Width="760"
        Icon="/Assets/app_icon.ico"
        Background="{StaticResource BgOuterBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <DockPanel Margin="18">

    <!-- 対象の単位。作曲家は単位から決まっているので固定表示にする（docs/SPEC.md 7.3.2） -->
    <Border DockPanel.Dock="Top" Style="{StaticResource CardBorderStyle}" Padding="14,12">
      <StackPanel>
        <TextBlock Text="{Binding Composer}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,5,0,0"
                   Text="{Binding Header}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Style="{StaticResource NoticePanelBorderStyle}" Padding="14,12" Margin="0,10,0,0">
      <TextBlock Style="{StaticResource NoticeItemTextStyle}" Margin="0" Text="{Binding Notice}" />
    </Border>

    <Border DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="キャンセル" Click="OnCancel" IsCancel="True" Margin="0,0,10,0" />
        <Button Content="辞書に追加して再検査" Click="OnAccept" IsDefault="True"
                Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
      <StackPanel Margin="0,0,8,0">

        <!--
          作品名は空で出す。現在の album の値は誤っていることがあり、
          機械が正規形として採用してはならない（TAGGING_POLICY 3.5 補足2）。
        -->
        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="作品名（アルバム名にそのまま入る値）" />
        <TextBox ctl:Placeholder.Text="Symphony No. 8 / Die Walküre のように書く"
                 Text="{Binding Canonical, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource SectionLabelStyle}" Margin="0,16,0,4"
                   Text="別名の候補（この単位の album 値とフォルダ名。要らないものは外す）" />
        <Border Style="{StaticResource CardBorderStyle}" Padding="1">
          <ItemsControl ItemsSource="{Binding Candidates}" MaxHeight="200">
            <ItemsControl.Template>
              <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
                  <ItemsPresenter />
                </ScrollViewer>
              </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox Margin="0,3" IsChecked="{Binding IsSelected}" Content="{Binding DisplayText}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <TextBlock Style="{StaticResource SectionLabelStyle}" Margin="0,16,0,4" Text="その他の別名（1 行 1 件）" />
        <TextBox Height="110"
                 Style="{StaticResource DarkMultilineTextBoxStyle}"
                 Text="{Binding ExtraAliasesText, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="日本語を含む別名は aliasesJa に、それ以外は aliases に自動で振り分けられます。作品名と同じ値は登録されません。" />

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
