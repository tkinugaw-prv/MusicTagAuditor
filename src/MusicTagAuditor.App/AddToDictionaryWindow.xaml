<Window x:Class="MusicTagAuditor.App.AddToDictionaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MusicTagAuditor.App.Converters"
        xmlns:ctl="clr-namespace:MusicTagAuditor.App.Controls"
        Title="辞書に追加" Height="580" Width="720"
        Icon="/Assets/app_icon.ico"
        Background="{StaticResource BgOuterBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:InverseBooleanConverter x:Key="InverseBool" />
    <conv:EnumToBooleanConverter x:Key="EnumToBool" />
    <conv:EnumToVisibilityConverter x:Key="EnumToVisibility" />
  </Window.Resources>

  <DockPanel Margin="18">

    <!-- 対象の値 -->
    <Border DockPanel.Dock="Top" Style="{StaticResource CardBorderStyle}" Padding="14,12">
      <StackPanel>
        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,5,0,0"
                   Text="{Binding SamplePath}" />
      </StackPanel>
    </Border>

    <!-- 注意書き。原則との齟齬をここで気づけるようにする -->
    <Border DockPanel.Dock="Top" Style="{StaticResource NoticePanelBorderStyle}" Padding="14,12" Margin="0,10,0,0">
      <TextBlock Style="{StaticResource NoticeItemTextStyle}" Margin="0" Text="{Binding Notice}" />
    </Border>

    <!-- 実行ボタン -->
    <Border DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="キャンセル" Click="OnCancel" IsCancel="True" Margin="0,0,10,0" />
        <Button Content="辞書に追加して再検査" Click="OnAccept" IsDefault="True"
                Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
      <StackPanel Margin="0,0,8,0">

        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="種別" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
          <RadioButton Content="作曲家" GroupName="Category" Margin="0,0,18,0"
                       IsChecked="{Binding Category, Converter={StaticResource EnumToBool}, ConverterParameter=Composer}" />
          <RadioButton Content="人物（指揮者・ソリスト）" GroupName="Category" Margin="0,0,18,0"
                       IsChecked="{Binding Category, Converter={StaticResource EnumToBool}, ConverterParameter=Person}" />
          <RadioButton Content="演奏団体" GroupName="Category"
                       IsChecked="{Binding Category, Converter={StaticResource EnumToBool}, ConverterParameter=Ensemble}" />
        </StackPanel>

        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="登録のしかた" />
        <RadioButton Content="既にあるエントリの別名にする" GroupName="Mode" IsChecked="{Binding AddsToExisting}" />
        <RadioButton Content="新しいエントリを作る" GroupName="Mode" Margin="0,8,0,10"
                     IsChecked="{Binding AddsToExisting, Converter={StaticResource InverseBool}}" />

        <!-- 既存エントリに足す -->
        <StackPanel Visibility="{Binding AddsToExisting, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Style="{StaticResource SectionLabelStyle}" Margin="0,10,0,4" Text="足す先の正規形" />
          <TextBox Margin="0,0,0,6"
                   ctl:Placeholder.Text="一覧を絞り込む"
                   Text="{Binding CanonicalFilter, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="絞り込み" />
          <ListBox Height="220"
                   ItemsSource="{Binding Canonicals}"
                   SelectedItem="{Binding SelectedCanonical}" />
        </StackPanel>

        <!-- 新しいエントリを作る -->
        <StackPanel Visibility="{Binding AddsToExisting, Converter={StaticResource InverseBoolToVisibility}}">
          <TextBlock Style="{StaticResource SectionLabelStyle}" Margin="0,10,0,4" Text="正規形" />
          <TextBox Text="{Binding NewCanonical, UpdateSourceTrigger=PropertyChanged}" />

          <StackPanel Visibility="{Binding Category, Converter={StaticResource EnumToVisibility}, ConverterParameter=Ensemble}">
            <TextBlock Style="{StaticResource SectionLabelStyle}" Margin="0,12,0,4" Text="実体 ID（改名をまたいで同一の団体を指す）" />
            <TextBox Text="{Binding NewEntityId, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="先頭に国コード（de- / uk- / us- 等）を付けてください（TAGGING_POLICY 5.3.1）。自動提案は正規形をそのままスラッグ化したものなので、この形にはなりません。" />
          </StackPanel>

          <StackPanel Visibility="{Binding Category, Converter={StaticResource EnumToVisibility}, ConverterParameter=Person}">
            <TextBlock Style="{StaticResource SectionLabelStyle}" Margin="0,12,0,4" Text="役割" />
            <StackPanel Orientation="Horizontal">
              <CheckBox Content="指揮者" IsChecked="{Binding IsConductor}" Margin="0,0,18,0" />
              <CheckBox Content="ソリスト" IsChecked="{Binding IsSoloist}" />
            </StackPanel>
          </StackPanel>

          <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,12,0,0"
                     Text="タグに入っている値は別名として自動で登録されます。正規形と同じ場合は重複しません。" />
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
