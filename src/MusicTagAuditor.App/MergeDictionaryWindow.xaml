<Window x:Class="MusicTagAuditor.App.MergeDictionaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="既定辞書から取り込む" Height="620" Width="840"
        Icon="/Assets/app_icon.ico"
        Background="{StaticResource BgOuterBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <DockPanel Margin="18">

    <Border DockPanel.Dock="Top" Style="{StaticResource CardBorderStyle}" Padding="14,12">
      <StackPanel>
        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,8,0,0"
                   Text="利用者辞書は初回起動時にコピーされたきり更新されません。アプリ側に追加されたエントリや設定はここから取り込みます。" />
        <TextBlock Style="{StaticResource NoticeItemTextStyle}" Margin="0,8,0,0"
                   Text="意図的に削除したエントリが含まれている場合は、その行のチェックを外してください。取り込みは追加だけを行い、編集済みの正規形は上書きしません。" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Left" Content="すべて選択" Click="OnSelectAll"
                Style="{StaticResource SmallOutlineButtonStyle}" Margin="0,0,6,0" />
        <Button DockPanel.Dock="Left" Content="すべて解除" Click="OnSelectNone"
                Style="{StaticResource SmallOutlineButtonStyle}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="キャンセル" Click="OnCancel" IsCancel="True" Margin="0,0,10,0" />
          <Button Content="取り込んで保存" Click="OnAccept" IsDefault="True"
                  Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Style="{StaticResource CardBorderStyle}" Padding="1" Margin="0,16,0,0">
      <DataGrid ItemsSource="{Binding Items}" CanUserSortColumns="True">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="取り込む" Width="70"
                                  Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                  ElementStyle="{StaticResource GridCheckBoxStyle}"
                                  EditingElementStyle="{StaticResource GridCheckBoxStyle}" />
          <DataGridTextColumn Header="種別" Width="70" IsReadOnly="True"
                              Binding="{Binding Category}"
                              ElementStyle="{StaticResource CenterCellTextStyle}" />
          <DataGridTextColumn Header="内容" Width="*" IsReadOnly="True"
                              Binding="{Binding Summary}"
                              ElementStyle="{StaticResource EllipsisTextStyle}" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</Window>
