<!-- StartupUri は使わない。メインウィンドウは DI 経由で App.OnStartup から表示する。 -->
<Application x:Class="MusicTagAuditor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--
          配色・コントロールの見た目は「音楽フォルダー時間フィッター」と同じ定義に揃える。
          重大度のバッジ・件数列・入力欄の見出しなど、画面が参照するスタイルも
          すべてこの 1 枚に集約している。App.xaml には値を置かないこと。
        -->
        <ResourceDictionary Source="Themes/DarkTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
