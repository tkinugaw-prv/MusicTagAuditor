<Window x:Class="MusicTagger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MusicTagger.App.ViewModels"
        Title="musicTagger" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- フォルダツリー。子フォルダを再帰的に展開する。 -->
    <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}"
                              ItemsSource="{Binding Children}">
      <TextBlock Text="{Binding DisplayText}" />
    </HierarchicalDataTemplate>
  </Window.Resources>

  <DockPanel>

    <!-- ツールバー -->
    <Border DockPanel.Dock="Top" Padding="8" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
      <DockPanel>
        <Button Content="フォルダを開く" Command="{Binding OpenLibraryCommand}" Padding="12,4" Margin="0,0,8,0" />
        <Button Content="再スキャン" Command="{Binding RescanCommand}" Padding="12,4" Margin="0,0,8,0" />
        <Button Content="中止" Command="{Binding CancelScanCommand}" Padding="12,4" Margin="0,0,12,0" />
        <TextBlock Text="{Binding LibraryRoot, TargetNullValue='(未選択)'}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#333333" />
      </DockPanel>
    </Border>

    <!-- ステータスバー -->
    <Border DockPanel.Dock="Bottom" Padding="8,6" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
      <DockPanel>
        <ProgressBar DockPanel.Dock="Right" Width="220" Height="16" Margin="12,0,0,0"
                     Minimum="0"
                     Maximum="{Binding ProgressMaximum}"
                     Value="{Binding ProgressValue}"
                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" MinWidth="180" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <TreeView Grid.Column="0"
                ItemsSource="{Binding FolderTree}"
                SelectedItemChanged="OnFolderSelectionChanged"
                BorderThickness="0">
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneTime}" />
          </Style>
        </TreeView.ItemContainerStyle>
      </TreeView>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#EEEEEE" />

      <TabControl Grid.Column="2" Margin="4">

        <TabItem Header="ファイル一覧">
          <DataGrid ItemsSource="{Binding Tracks}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserSortColumns="True"
                    EnableRowVirtualization="True"
                    EnableColumnVirtualization="True"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    SelectionMode="Extended">

            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Setter Property="ToolTip" Value="{Binding SplitValueSummary}" />
                <Style.Triggers>
                  <!-- 複数値として格納されている行は、表示上は連結されて見えるため色で区別する -->
                  <DataTrigger Binding="{Binding HasSplitValues}" Value="True">
                    <Setter Property="Background" Value="#FFF6E5" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
              <DataGridTextColumn Header="ファイル" Binding="{Binding FileName}" Width="220" />
              <DataGridTextColumn Header="フォルダ" Binding="{Binding FolderPath}" Width="200" />
              <DataGridTextColumn Header="形式" Binding="{Binding Format}" Width="60" />
              <DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="240" />
              <DataGridTextColumn Header="作曲家" Binding="{Binding Composer}" Width="160" />
              <DataGridTextColumn Header="アーティスト" Binding="{Binding Artist}" Width="160" />
              <DataGridTextColumn Header="指揮者" Binding="{Binding Conductor}" Width="160" />
              <DataGridTextColumn Header="アルバムアーティスト" Binding="{Binding AlbumArtist}" Width="200" />
              <DataGridTextColumn Header="アルバム" Binding="{Binding Album}" Width="220" />
              <DataGridTextColumn Header="ジャンル" Binding="{Binding Genre}" Width="80" />
              <DataGridTextColumn Header="年" Binding="{Binding Date}" Width="60" />
              <DataGridTextColumn Header="トラック" Binding="{Binding TrackNumber}" Width="70" />
              <DataGridTextColumn Header="ディスク" Binding="{Binding DiscNumber}" Width="70" />
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>

        <TabItem Header="読み取り失敗">
          <DataGrid ItemsSource="{Binding Failures}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="パス" Binding="{Binding RelativePath}" Width="400" />
              <DataGridTextColumn Header="内容" Binding="{Binding Message}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>

      </TabControl>
    </Grid>
  </DockPanel>
</Window>
