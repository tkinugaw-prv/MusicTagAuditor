<Window x:Class="MusicTagger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MusicTagger.App.ViewModels"
        xmlns:conv="clr-namespace:MusicTagger.App.Converters"
        Title="musicTagger" Height="900" Width="1440"
        MinHeight="680" MinWidth="1120"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
    <conv:TagFieldLabelConverter x:Key="TagFieldLabel" />

    <!-- フォルダツリー。子フォルダを再帰的に展開する。 -->
    <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}"
                              ItemsSource="{Binding Children}">
      <TextBlock Text="{Binding DisplayText}" />
    </HierarchicalDataTemplate>

    <!--
      重大度のバッジ。既定は「要確認」の配色にし、他の重大度をトリガで上書きする。
      記号 1 文字では実描画で区別が付かないため、必ず文字ラベルを出すこと。
    -->
    <DataTemplate x:Key="SeverityBadge">
      <Border x:Name="Badge" CornerRadius="3" Padding="6,1" Margin="0,1"
              HorizontalAlignment="Left" VerticalAlignment="Center"
              Background="{StaticResource SeverityInfoBackground}">
        <TextBlock x:Name="Label" Text="{Binding SeverityLabel}" FontSize="11"
                   Foreground="{StaticResource SeverityInfoForeground}" />
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Severity}" Value="Error">
          <Setter TargetName="Badge" Property="Background" Value="{StaticResource SeverityErrorBackground}" />
          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource SeverityErrorForeground}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="Warning">
          <Setter TargetName="Badge" Property="Background" Value="{StaticResource SeverityWarningBackground}" />
          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource SeverityWarningForeground}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="Manual">
          <Setter TargetName="Badge" Property="Background" Value="{StaticResource SeverityManualBackground}" />
          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource SeverityManualForeground}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>

    <!-- ツールバー -->
    <Border DockPanel.Dock="Top" Padding="8" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
      <DockPanel>
        <Button Content="フォルダを開く" Command="{Binding OpenLibraryCommand}" Padding="12,4" Margin="0,0,8,0" />
        <Button Content="再スキャン" Command="{Binding RescanCommand}" Padding="12,4" Margin="0,0,8,0" />
        <Button Content="中止" Command="{Binding CancelScanCommand}" Padding="12,4" Margin="0,0,16,0" />
        <Button Content="検査" Command="{Binding InspectCommand}" Padding="12,4" Margin="0,0,8,0" FontWeight="Bold" />
        <Button Content="バックアップ" Command="{Binding CreateBackupCommand}" Padding="12,4" Margin="0,0,12,0" />
        <CheckBox Content="発音区別符号も検査" VerticalAlignment="Center" Margin="0,0,12,0"
                  IsChecked="{Binding EnableDiacriticCheck}"
                  ToolTip="R-304。誤検出が増えるため既定では無効です" />
        <TextBlock Text="{Binding LibraryRoot, TargetNullValue='(未選択)'}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#333333" />
      </DockPanel>
    </Border>

    <!-- ステータスバー -->
    <Border DockPanel.Dock="Bottom" Padding="8,6" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
      <DockPanel>
        <ProgressBar DockPanel.Dock="Right" Width="220" Height="16" Margin="12,0,0,0"
                     Minimum="0"
                     Maximum="{Binding ProgressMaximum}"
                     Value="{Binding ProgressValue}"
                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" MinWidth="180" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <TreeView Grid.Column="0"
                ItemsSource="{Binding FolderTree}"
                SelectedItemChanged="OnFolderSelectionChanged"
                BorderThickness="0">
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneTime}" />
          </Style>
        </TreeView.ItemContainerStyle>
      </TreeView>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#EEEEEE" />

      <TabControl Grid.Column="2" Margin="4">

        <TabItem Header="検査結果">
          <Grid>
            <Grid.RowDefinitions>
              <!-- 24 ルールを一望できる高さを既定で確保し、スプリッタで下段と融通する -->
              <RowDefinition Height="*" MinHeight="140" />
              <RowDefinition Height="6" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="140" />
            </Grid.RowDefinitions>

            <!-- 上段: ルール別の集計 -->
            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding RuleResults}"
                      SelectedItem="{Binding SelectedRule}"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="適用" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                <DataGridTemplateColumn Header="重大度" CellTemplate="{StaticResource SeverityBadge}"
                                        IsReadOnly="True" Width="76" SortMemberPath="Severity" />
                <DataGridTextColumn Header="ID" Binding="{Binding RuleId}" IsReadOnly="True" Width="70" />
                <!-- 件数は ID の隣にまとめる。「内容」の後ろに置くと右端まで目線が飛ぶ -->
                <DataGridTextColumn Header="検出" Binding="{Binding Count, StringFormat=N0}" IsReadOnly="True" Width="70"
                                    ElementStyle="{StaticResource NumericCell}"
                                    HeaderStyle="{StaticResource NumericColumnHeader}" />
                <DataGridTextColumn Header="修正可" Binding="{Binding FixableCount, StringFormat=N0}" IsReadOnly="True" Width="70"
                                    ElementStyle="{StaticResource NumericCell}"
                                    HeaderStyle="{StaticResource NumericColumnHeader}" />
                <DataGridTextColumn Header="保留" Binding="{Binding HoldCount, StringFormat=N0}" IsReadOnly="True" Width="70"
                                    ElementStyle="{StaticResource NumericCell}"
                                    HeaderStyle="{StaticResource NumericColumnHeader}" />
                <DataGridTextColumn Header="内容" Binding="{Binding Description}" IsReadOnly="True" Width="*" MinWidth="240" />
              </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="#EEEEEE" />

            <Border Grid.Row="2" Padding="0,8" BorderBrush="#DDDDDD" BorderThickness="0,1,0,1" Margin="0,4">
              <DockPanel>
                <Button DockPanel.Dock="Left" Content="チェックした項目を適用"
                        Command="{Binding ApplyCommand}" Padding="12,4" Margin="0,0,8,0" FontWeight="Bold" />
                <Button DockPanel.Dock="Left" Content="CSV出力"
                        Command="{Binding ExportCsvCommand}" Padding="12,4" Margin="0,0,8,0"
                        ToolTip="明細と集計の 2 ファイルを書き出します" />
                <Button DockPanel.Dock="Left" Content="選択行を辞書に追加"
                        Command="{Binding AddSelectedChangeToDictionaryCommand}" Padding="12,4" Margin="0,0,12,0"
                        ToolTip="修正案を出せなかった行を辞書に登録して再検査します" />
                <TextBlock Text="{Binding InspectionSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
              </DockPanel>
            </Border>

            <!-- 適用で問題が起きた項目。不一致が 1 件でもあれば必ず見せる（docs/SPEC.md 9章） -->
            <ItemsControl Grid.Row="3"
                          ItemsSource="{Binding ApplyIssues}"
                          MaxHeight="120"
                          Background="#FFF0F0"
                          Margin="0,0,0,4"
                          Visibility="{Binding ApplyIssues.Count, Converter={StaticResource CountToVisibility}}">
              <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,6">
                    <ItemsPresenter />
                  </ScrollViewer>
                </ControlTemplate>
              </ItemsControl.Template>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#A00000" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 下段: 差分プレビュー。根拠列を必ず持つ（docs/SPEC.md 5.3） -->
            <DataGrid Grid.Row="4"
                      ItemsSource="{Binding InspectionChanges}"
                      SelectedItem="{Binding SelectedChange}"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      EnableRowVirtualization="True"
                      GridLinesVisibility="Horizontal">

              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                  <Style.Triggers>
                    <!-- 判定区分で色を変える（確定 / 要確認 / 保留） -->
                    <DataTrigger Binding="{Binding Classification}" Value="確定">
                      <Setter Property="Background" Value="#EAF7EA" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Classification}" Value="要確認">
                      <Setter Property="Background" Value="#FFF6E5" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Classification}" Value="保留">
                      <Setter Property="Background" Value="#EDEDED" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.RowStyle>

              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="適用" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                <DataGridTextColumn Header="区分" Binding="{Binding Classification}" IsReadOnly="True" Width="60" />
                <!--
                  幅は star で配分する。固定幅だと根拠列が画面外に出るが、
                  自動判定の理由が読めないと承認できない（docs/SPEC.md 5.3）。
                -->
                <DataGridTextColumn Header="パス" Binding="{Binding RelativePath}" IsReadOnly="True" Width="2*" MinWidth="180" />
                <DataGridTextColumn Header="タグ" Binding="{Binding Field}" IsReadOnly="True" Width="90" />
                <DataGridTextColumn Header="変更前" Binding="{Binding BeforeText}" IsReadOnly="True" Width="1.5*" MinWidth="120" />
                <DataGridTextColumn Header="変更後" Binding="{Binding AfterText}" IsReadOnly="True" Width="1.5*" MinWidth="120" />
                <DataGridTextColumn Header="根拠" Binding="{Binding Rationale}" IsReadOnly="True" Width="2*" MinWidth="160" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <!-- 辞書に無い値。docs/SPEC.md 7.3 が「最も使用頻度が高い」とする導線 -->
        <TabItem Header="辞書に無い値">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="0,8" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Margin="0,0,0,4">
              <DockPanel>
                <Button DockPanel.Dock="Left" Content="辞書に追加"
                        Command="{Binding AddUnknownValueToDictionaryCommand}"
                        Padding="12,4" Margin="0,0,12,0" FontWeight="Bold" />
                <TextBlock Text="{Binding UnknownValueSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
              </DockPanel>
            </Border>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding UnknownValues}"
                      SelectedItem="{Binding SelectedUnknownValue}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserSortColumns="True"
                      GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="件数" Binding="{Binding Count, StringFormat=N0}" Width="70"
                                    ElementStyle="{StaticResource NumericCell}"
                                    HeaderStyle="{StaticResource NumericColumnHeader}" />
                <DataGridTextColumn Header="値" Binding="{Binding Value}" Width="2*" MinWidth="180" />
                <DataGridTextColumn Header="登録先" Binding="{Binding CategoryText}" Width="80" />
                <DataGridTextColumn Header="フィールド" Binding="{Binding FieldsText}" Width="150" />
                <DataGridTextColumn Header="ルール" Binding="{Binding RuleIdsText}" Width="80" />
                <DataGridTextColumn Header="代表ファイル" Binding="{Binding SampleRelativePath}" Width="3*" MinWidth="200" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <!-- ファイル一覧。手編集はここで行う（docs/SPEC.md 5.2） -->
        <TabItem Header="ファイル一覧">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="160" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <!-- 保留中の編集。0 件のときは畳んで一覧に高さを譲る -->
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
              絞り込みと一括入力。DockPanel だと右端の要素が幅不足で欠けるため、
              列を明示した Grid で組む。2 段の入力欄は同じ列に揃える。
            -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="絞り込み" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Padding="4"
                       Text="{Binding TrackFilterText, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="パスとすべてのタグを対象に検索します" />
              <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0">
                <CheckBox Content="空欄のある行のみ" VerticalAlignment="Center"
                          IsChecked="{Binding ShowOnlyEmptyFields}" Margin="0,0,12,0" />
                <CheckBox Content="編集した行のみ" VerticalAlignment="Center"
                          IsChecked="{Binding ShowOnlyEditedTracks}" />
              </StackPanel>

              <TextBlock Grid.Row="1" Grid.Column="0" Text="一括入力" VerticalAlignment="Center"
                         Margin="0,6,6,0" FontWeight="Bold" />
              <ComboBox Grid.Row="1" Grid.Column="1" Width="160" Margin="0,6,6,0"
                        ItemsSource="{Binding EditableFields}"
                        SelectedItem="{Binding BulkField}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource TagFieldLabel}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBox Grid.Row="1" Grid.Column="2" Padding="4" Margin="0,6,0,0"
                       Text="{Binding BulkValue, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Row="1" Grid.Column="3" Content="選択行に一括入力"
                      Command="{Binding BulkInputCommand}"
                      CommandParameter="{Binding SelectedItems, ElementName=TrackGrid}"
                      Padding="12,4" Margin="12,6,0,0"
                      ToolTip="選択した行すべてに同じ値を入れます。空欄のまま押すとタグを消します" />
            </Grid>

            <DataGrid Grid.Row="1"
                      x:Name="TrackGrid"
                      ItemsSource="{Binding Tracks}"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow">

              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                  <Setter Property="ToolTip" Value="{Binding SplitValueSummary}" />
                  <Style.Triggers>
                    <!-- 複数値として格納されている行は、表示上は連結されて見えるため色で区別する -->
                    <DataTrigger Binding="{Binding HasSplitValues}" Value="True">
                      <Setter Property="Background" Value="#FFF6E5" />
                    </DataTrigger>
                    <!-- 保留中の編集がある行。まだファイルには書き込まれていない -->
                    <DataTrigger Binding="{Binding IsEdited}" Value="True">
                      <Setter Property="Background" Value="#E8F1FF" />
                      <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.RowStyle>

              <DataGrid.Columns>
                <!--
                  13 列を 1 画面に収めきることはできないため横スクロールは残す。
                  幅は star にして、ウィンドウを広げた分が文字列の列に回るようにする。
                  MinWidth は見出しが欠けない下限。
                -->
                <!-- ファイル名・フォルダ・形式は編集できない。リネームは対象外（docs/SPEC.md 2.2） -->
                <DataGridTextColumn Header="ファイル" Binding="{Binding FileName}" IsReadOnly="True" Width="1.6*" MinWidth="160" />
                <DataGridTextColumn Header="フォルダ" Binding="{Binding FolderPath}" IsReadOnly="True" Width="1.2*" MinWidth="120" />
                <DataGridTextColumn Header="形式" Binding="{Binding Format}" IsReadOnly="True" Width="64" />
                <DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="2*" MinWidth="180" />
                <DataGridTextColumn Header="作曲家" Binding="{Binding Composer}" Width="1.2*" MinWidth="120" />
                <DataGridTextColumn Header="アーティスト" Binding="{Binding Artist}" Width="1.2*" MinWidth="120" />
                <DataGridTextColumn Header="指揮者" Binding="{Binding Conductor}" Width="1.2*" MinWidth="120" />
                <DataGridTextColumn Header="アルバムアーティスト" Binding="{Binding AlbumArtist}" Width="1.4*" MinWidth="150" />
                <DataGridTextColumn Header="アルバム" Binding="{Binding Album}" Width="1.6*" MinWidth="160" />
                <DataGridTextColumn Header="ジャンル" Binding="{Binding Genre}" Width="72" />
                <DataGridTextColumn Header="年" Binding="{Binding Date}" Width="56" />
                <DataGridTextColumn Header="トラック" Binding="{Binding TrackNumber}" Width="66" />
                <DataGridTextColumn Header="ディスク" Binding="{Binding DiscNumber}" Width="66" />
              </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2" Padding="0,8" BorderBrush="#DDDDDD" BorderThickness="0,1,0,1" Margin="0,4">
              <DockPanel>
                <Button DockPanel.Dock="Left" Content="編集内容を適用"
                        Command="{Binding ApplyManualEditsCommand}" Padding="12,4" Margin="0,0,8,0" FontWeight="Bold" />
                <Button DockPanel.Dock="Left" Content="編集を破棄"
                        Command="{Binding DiscardManualEditsCommand}" Padding="12,4" Margin="0,0,12,0" />
                <TextBlock Text="{Binding ManualEditSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
              </DockPanel>
            </Border>

            <!-- 気づいてほしい点。止めはしないが黙って通しもしない -->
            <ItemsControl Grid.Row="3"
                          ItemsSource="{Binding ManualEditWarnings}"
                          MaxHeight="110"
                          Background="#FFF7F0"
                          Margin="0,0,0,4"
                          Visibility="{Binding ManualEditWarnings.Count, Converter={StaticResource CountToVisibility}}">
              <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,6">
                    <ItemsPresenter />
                  </ScrollViewer>
                </ControlTemplate>
              </ItemsControl.Template>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#8A4B00" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--
              保留中の編集。適用前に必ずここで差分を確認できる。
              1 件も無いうちは畳んで一覧に高さを譲る（編集が入った時点で現れる）。
            -->
            <DataGrid Grid.Row="4"
                      ItemsSource="{Binding ManualEditChanges}"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      MinHeight="100" MaxHeight="260"
                      GridLinesVisibility="Horizontal"
                      Visibility="{Binding ManualEditChanges.Count, Converter={StaticResource CountToVisibility}}">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="適用" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                <DataGridTextColumn Header="パス" Binding="{Binding RelativePath}" IsReadOnly="True" Width="2*" MinWidth="180" />
                <DataGridTextColumn Header="タグ" Binding="{Binding Field}" IsReadOnly="True" Width="100" />
                <DataGridTextColumn Header="変更前" Binding="{Binding BeforeText}" IsReadOnly="True" Width="1.5*" MinWidth="120" />
                <DataGridTextColumn Header="変更後" Binding="{Binding AfterText}" IsReadOnly="True" Width="1.5*" MinWidth="120" />
                <DataGridTextColumn Header="根拠" Binding="{Binding Rationale}" IsReadOnly="True" Width="2*" MinWidth="160" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <!-- 辞書（docs/SPEC.md 7.3） -->
        <TabItem Header="辞書" DataContext="{Binding Dictionary}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ツールバー -->
            <StackPanel Grid.Row="0" Margin="0,0,0,6">
              <DockPanel>
                <Button DockPanel.Dock="Left" Content="保存" Command="{Binding SaveCommand}"
                        Padding="12,4" Margin="0,0,8,0" FontWeight="Bold" />
                <Button DockPanel.Dock="Left" Content="検証だけ実行" Command="{Binding ValidateCommand}"
                        Padding="12,4" Margin="0,0,8,0" />
                <Button DockPanel.Dock="Left" Content="編集を破棄" Command="{Binding RevertCommand}"
                        Padding="12,4" Margin="0,0,8,0" />
                <Button DockPanel.Dock="Left" Content="既定辞書から取り込む" Command="{Binding MergeFromDefaultCommand}"
                        Padding="12,4" Margin="0,0,8,0"
                        ToolTip="アプリ側に追加されたエントリや設定を、この辞書へ取り込みます">
                  <Button.Style>
                    <Style TargetType="Button">
                      <Style.Triggers>
                        <!-- 取り込めるものがあるときだけ目立たせる -->
                        <DataTrigger Binding="{Binding PendingMergeCount, Converter={StaticResource CountToVisibility}}" Value="Visible">
                          <Setter Property="FontWeight" Value="Bold" />
                          <Setter Property="Background" Value="#FFF0D0" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Button DockPanel.Dock="Left" Content="既定辞書として書き出し" Command="{Binding ExportCommand}"
                        Padding="12,4" Margin="0,0,12,0"
                        ToolTip="リポジトリ同梱の default-dictionary.json へ書き戻します" />
                <TextBlock DockPanel.Dock="Right" Text="● 未保存" Foreground="#C05000" VerticalAlignment="Center"
                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                <!-- ラベルが無いと右上の空欄が何なのか分からない -->
                <TextBlock DockPanel.Dock="Left" Text="絞り込み" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="4" Margin="0,0,12,0" MinWidth="200"
                         ToolTip="正規形・別名・実体 ID で絞り込む" />
              </DockPanel>

              <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#333333" />
              <DockPanel Margin="0,2,0,0">
                <TextBlock DockPanel.Dock="Left" Text="辞書ファイル" Foreground="#666666" Margin="0,0,6,0" />
                <TextBlock Text="{Binding FilePath}" Foreground="#555555" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding FilePath}" />
              </DockPanel>
            </StackPanel>

            <TabControl Grid.Row="1">

              <!-- 作曲家 -->
              <TabItem Header="作曲家">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" MinWidth="160" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                      <Button Content="追加" Command="{Binding AddComposerCommand}" Padding="10,3" Margin="0,0,6,0" />
                      <Button Content="削除" Command="{Binding RemoveComposerCommand}" Padding="10,3" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Composers}" SelectedItem="{Binding SelectedComposer}"
                             DisplayMemberPath="Canonical" />
                  </DockPanel>

                  <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#EEEEEE" />

                  <Grid Grid.Column="2" Margin="8,0,0,0">
                    <!--
                      別名と日本語表記は横並びにする。縦に積むと 1 行の正規形に対して
                      入力欄だけが極端に縦長になり、釣り合いが崩れる。
                    -->
                    <Grid MaxWidth="900" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                      <Grid.Style>
                        <Style TargetType="Grid">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedComposer}" Value="{x:Null}">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Grid.Style>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="正規形" Style="{StaticResource FieldLabel}" />
                      <TextBox Grid.Row="1" Grid.ColumnSpan="3" Padding="4"
                               Text="{Binding SelectedComposer.Canonical, UpdateSourceTrigger=PropertyChanged}" />

                      <TextBlock Grid.Row="2" Grid.Column="0" Text="別名（1 行 1 件）"
                                 Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                      <TextBlock Grid.Row="2" Grid.Column="2" Text="日本語表記（1 行 1 件）"
                                 Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                      <!-- 高さを上限で止める。画面いっぱいに伸ばすと 1 行の正規形との対比が崩れる -->
                      <TextBox Grid.Row="3" Grid.Column="0" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                               Height="240"
                               Text="{Binding SelectedComposer.AliasesText, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBox Grid.Row="3" Grid.Column="2" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                               Height="240"
                               Text="{Binding SelectedComposer.AliasesJaText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <TextBlock Text="左の一覧から作曲家を選ぶと、ここで編集できます。&#x0a;新しく登録するときは「追加」を押してください。">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderText}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedComposer}" Value="{x:Null}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </Grid>
              </TabItem>

              <!-- 人物 -->
              <TabItem Header="人物">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" MinWidth="160" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                      <Button Content="追加" Command="{Binding AddPersonCommand}" Padding="10,3" Margin="0,0,6,0" />
                      <Button Content="削除" Command="{Binding RemovePersonCommand}" Padding="10,3" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Persons}" SelectedItem="{Binding SelectedPerson}"
                             DisplayMemberPath="Canonical" />
                  </DockPanel>

                  <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#EEEEEE" />

                  <Grid Grid.Column="2" Margin="8,0,0,0">
                    <Grid MaxWidth="900" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                      <Grid.Style>
                        <Style TargetType="Grid">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedPerson}" Value="{x:Null}">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Grid.Style>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="正規形" Style="{StaticResource FieldLabel}" />
                      <TextBox Grid.Row="1" Grid.ColumnSpan="3" Padding="4"
                               Text="{Binding SelectedPerson.Canonical, UpdateSourceTrigger=PropertyChanged}" />
                      <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox Content="指揮者" IsChecked="{Binding SelectedPerson.IsConductor}" Margin="0,0,16,0" />
                        <CheckBox Content="ソリスト" IsChecked="{Binding SelectedPerson.IsSoloist}" />
                      </StackPanel>

                      <TextBlock Grid.Row="3" Grid.Column="0" Text="別名（1 行 1 件）"
                                 Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                      <TextBlock Grid.Row="3" Grid.Column="2" Text="日本語表記（1 行 1 件）"
                                 Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                      <!-- 高さを上限で止める。画面いっぱいに伸ばすと 1 行の正規形との対比が崩れる -->
                      <TextBox Grid.Row="4" Grid.Column="0" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                               Height="240"
                               Text="{Binding SelectedPerson.AliasesText, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBox Grid.Row="4" Grid.Column="2" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                               Height="240"
                               Text="{Binding SelectedPerson.AliasesJaText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <TextBlock Text="左の一覧から人物を選ぶと、ここで編集できます。&#x0a;新しく登録するときは「追加」を押してください。">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderText}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedPerson}" Value="{x:Null}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </Grid>
              </TabItem>

              <!-- 団体 -->
              <TabItem Header="団体">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" MinWidth="160" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                      <Button Content="追加" Command="{Binding AddEnsembleCommand}" Padding="10,3" Margin="0,0,6,0" />
                      <Button Content="削除" Command="{Binding RemoveEnsembleCommand}" Padding="10,3" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Ensembles}" SelectedItem="{Binding SelectedEnsemble}"
                             DisplayMemberPath="DisplayName" />
                  </DockPanel>

                  <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#EEEEEE" />

                  <Grid Grid.Column="2" Margin="8,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedEnsemble}" Value="{x:Null}">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ScrollViewer.Style>
                      <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" Margin="0,0,8,0">
                        <TextBlock Text="実体 ID（改名をまたいで同一の団体を指す。名前の類似で束ねないこと）"
                                   Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <TextBox Padding="4"
                                 Text="{Binding SelectedEnsemble.EntityId, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="正規形（時代分割しない場合）" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                        <TextBox Padding="4"
                                 Text="{Binding SelectedEnsemble.Canonical, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Content="時代分割を行わない（個別例外。TAGGING_POLICY 5.3.2）"
                                  IsChecked="{Binding SelectedEnsemble.NoEraSplit}" Margin="0,8,0,0" />

                        <DockPanel Margin="0,12,0,4">
                          <Button DockPanel.Dock="Right" Content="区分を削除" Command="{Binding RemoveEraCommand}" Padding="8,2" />
                          <Button DockPanel.Dock="Right" Content="区分を追加" Command="{Binding AddEraCommand}" Padding="8,2" Margin="0,0,6,0" />
                          <TextBlock Text="時代分割（収録時点の名称を採用する。TAGGING_POLICY 5.3.1）" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding SelectedEnsemble.Eras}"
                                  SelectedItem="{Binding SelectedEra}"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  MinHeight="72"
                                  MaxHeight="160"
                                  GridLinesVisibility="Horizontal">
                          <DataGrid.Columns>
                            <DataGridTextColumn Header="この年以降" Binding="{Binding FromText, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            <DataGridTextColumn Header="この年より前" Binding="{Binding UntilText, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                            <DataGridTextColumn Header="正規形" Binding="{Binding Canonical, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                          </DataGrid.Columns>
                        </DataGrid>

                        <!-- 別名と日本語表記は横並びにする。作曲家・人物タブと同じ組み方 -->
                        <Grid Margin="0,12,0,0">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Row="0" Grid.Column="0" Text="別名（1 行 1 件）" Style="{StaticResource FieldLabel}" />
                          <TextBlock Grid.Row="0" Grid.Column="2" Text="日本語表記（1 行 1 件）" Style="{StaticResource FieldLabel}" />
                          <TextBox Grid.Row="1" Grid.Column="0" Height="110" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                   Text="{Binding SelectedEnsemble.AliasesText, UpdateSourceTrigger=PropertyChanged}" />
                          <TextBox Grid.Row="1" Grid.Column="2" Height="110" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                   Text="{Binding SelectedEnsemble.AliasesJaText, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                      </StackPanel>
                    </ScrollViewer>

                    <TextBlock Text="左の一覧から団体を選ぶと、ここで編集できます。&#x0a;新しく登録するときは「追加」を押してください。">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderText}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedEnsemble}" Value="{x:Null}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </Grid>
              </TabItem>

              <!-- 誤記 -->
              <TabItem Header="誤記">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="追加" Command="{Binding AddTypoCommand}" Padding="10,3" Margin="0,0,6,0" />
                    <Button Content="削除" Command="{Binding RemoveTypoCommand}" Padding="10,3" Margin="0,0,12,0" />
                    <TextBlock VerticalAlignment="Center" Foreground="#666666" TextWrapping="Wrap"
                               Text="照合は正規表現で行う。団体名には適用しない（Münchener Bach-Chor の -ener は正しい表記）。" />
                  </StackPanel>

                  <DataGrid Grid.Row="1"
                            ItemsSource="{Binding Typos}"
                            SelectedItem="{Binding SelectedTypo}"
                            AutoGenerateColumns="False"
                            SelectionMode="Single"
                            GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="パターン" Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Width="240" />
                      <DataGridTextColumn Header="置換後" Binding="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                      <DataGridTextColumn Header="メモ" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                      <DataGridTextColumn Header="正規表現" Binding="{Binding ValidityMark}" IsReadOnly="True" Width="80" />
                    </DataGrid.Columns>
                  </DataGrid>

                  <!-- その場で試せるテスト欄（docs/SPEC.md 7.3） -->
                  <Border Grid.Row="2" Padding="8" Margin="0,6,0,0" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="1">
                    <StackPanel>
                      <TextBlock Text="選択中のパターンを試す" FontWeight="Bold" Margin="0,0,0,4" />
                      <TextBox Padding="4" Text="{Binding TypoTestInput, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBlock Text="{Binding TypoTestResult}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#333333" />
                    </StackPanel>
                  </Border>
                </Grid>
              </TabItem>

              <!-- 保護対象 -->
              <TabItem Header="保護対象">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <StackPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock TextWrapping="Wrap" Foreground="#666666"
                               Text="配役情報を含むため書き換えない albumartist（TAGGING_POLICY 2.3）。ここに載っている値は全ルールの検査前に除外される。" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                      <Button Content="追加" Command="{Binding AddProtectedValueCommand}" Padding="10,3" Margin="0,0,6,0" />
                      <Button Content="削除" Command="{Binding RemoveProtectedValueCommand}" Padding="10,3" />
                    </StackPanel>
                  </StackPanel>

                  <ListBox Grid.Row="1"
                           ItemsSource="{Binding ProtectedValues}"
                           SelectedItem="{Binding SelectedProtectedValue}"
                           DisplayMemberPath="Value"
                           HorizontalContentAlignment="Stretch" />

                  <StackPanel Grid.Row="2" Margin="0,6,0,0">
                    <TextBlock Text="選択中の値" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBox Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="{Binding SelectedProtectedValue.Value, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
              </TabItem>

            </TabControl>

            <!-- 検証結果。エラーは保存を止める -->
            <ItemsControl Grid.Row="2"
                          ItemsSource="{Binding Issues}"
                          MaxHeight="130"
                          Margin="0,6,0,0"
                          Background="#FFF7F0"
                          Visibility="{Binding Issues.Count, Converter={StaticResource CountToVisibility}}">
              <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,6">
                    <ItemsPresenter />
                  </ScrollViewer>
                </ControlTemplate>
              </ItemsControl.Template>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#8A4B00" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </TabItem>

        <TabItem Header="バックアップ履歴">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="180" MinHeight="100" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Backups}"
                      SelectedItem="{Binding SelectedBackup}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="取得日時" Binding="{Binding CreatedAtText}" Width="160" />
                <DataGridTextColumn Header="理由" Binding="{Binding ReasonText}" Width="120" />
                <DataGridTextColumn Header="件数" Binding="{Binding TrackCountText}" Width="80"
                                    ElementStyle="{StaticResource NumericCell}"
                                    HeaderStyle="{StaticResource NumericColumnHeader}" />
                <DataGridTextColumn Header="補足" Binding="{Binding Note}" Width="*" MinWidth="140" />
                <DataGridTextColumn Header="フォルダ" Binding="{Binding DirectoryPath}" Width="2*" MinWidth="220" />
              </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1" Padding="0,8" BorderBrush="#DDDDDD" BorderThickness="0,1,0,1" Margin="0,4">
              <DockPanel>
                <Button DockPanel.Dock="Left" Content="差分を確認"
                        Command="{Binding PreviewRestoreCommand}" Padding="12,4" Margin="0,0,8,0" />
                <Button DockPanel.Dock="Left" Content="選択した項目を復元"
                        Command="{Binding RestoreCommand}" Padding="12,4" Margin="0,0,12,0" />
                <TextBlock Text="{Binding RestoreSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
              </DockPanel>
            </Border>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding RestoreItems}"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="戻す" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                <DataGridTextColumn Header="パス" Binding="{Binding RelativePath}" IsReadOnly="True" Width="2*" MinWidth="200" />
                <DataGridTextColumn Header="フィールド" Binding="{Binding Field}" IsReadOnly="True" Width="110" />
                <DataGridTextColumn Header="現在の値" Binding="{Binding CurrentText}" IsReadOnly="True" Width="1.5*" MinWidth="150" />
                <DataGridTextColumn Header="戻す値" Binding="{Binding SnapshotText}" IsReadOnly="True" Width="1.5*" MinWidth="150" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <TabItem Header="読み取り失敗">
          <DataGrid ItemsSource="{Binding Failures}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="パス" Binding="{Binding RelativePath}" Width="2*" MinWidth="240" />
              <DataGridTextColumn Header="内容" Binding="{Binding Message}" Width="3*" MinWidth="240" />
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>

      </TabControl>
    </Grid>
  </DockPanel>
</Window>
