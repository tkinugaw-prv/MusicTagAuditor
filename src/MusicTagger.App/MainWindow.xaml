<Window x:Class="MusicTagger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MusicTagger.App.ViewModels"
        xmlns:conv="clr-namespace:MusicTagger.App.Converters"
        Title="musicTagger" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:CountToVisibilityConverter x:Key="CountToVisibility" />

    <!-- フォルダツリー。子フォルダを再帰的に展開する。 -->
    <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}"
                              ItemsSource="{Binding Children}">
      <TextBlock Text="{Binding DisplayText}" />
    </HierarchicalDataTemplate>
  </Window.Resources>

  <DockPanel>

    <!-- ツールバー -->
    <Border DockPanel.Dock="Top" Padding="8" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
      <DockPanel>
        <Button Content="フォルダを開く" Command="{Binding OpenLibraryCommand}" Padding="12,4" Margin="0,0,8,0" />
        <Button Content="再スキャン" Command="{Binding RescanCommand}" Padding="12,4" Margin="0,0,8,0" />
        <Button Content="中止" Command="{Binding CancelScanCommand}" Padding="12,4" Margin="0,0,16,0" />
        <Button Content="検査" Command="{Binding InspectCommand}" Padding="12,4" Margin="0,0,8,0" FontWeight="Bold" />
        <Button Content="バックアップ" Command="{Binding CreateBackupCommand}" Padding="12,4" Margin="0,0,12,0" />
        <TextBlock Text="{Binding LibraryRoot, TargetNullValue='(未選択)'}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#333333" />
      </DockPanel>
    </Border>

    <!-- ステータスバー -->
    <Border DockPanel.Dock="Bottom" Padding="8,6" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
      <DockPanel>
        <ProgressBar DockPanel.Dock="Right" Width="220" Height="16" Margin="12,0,0,0"
                     Minimum="0"
                     Maximum="{Binding ProgressMaximum}"
                     Value="{Binding ProgressValue}"
                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" MinWidth="180" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <TreeView Grid.Column="0"
                ItemsSource="{Binding FolderTree}"
                SelectedItemChanged="OnFolderSelectionChanged"
                BorderThickness="0">
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneTime}" />
          </Style>
        </TreeView.ItemContainerStyle>
      </TreeView>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#EEEEEE" />

      <TabControl Grid.Column="2" Margin="4">

        <TabItem Header="検査結果">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="200" MinHeight="100" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 上段: ルール別の集計 -->
            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding RuleResults}"
                      SelectedItem="{Binding SelectedRule}"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="適用" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                <DataGridTextColumn Header="" Binding="{Binding SeverityMark}" IsReadOnly="True" Width="34" />
                <DataGridTextColumn Header="ID" Binding="{Binding RuleId}" IsReadOnly="True" Width="70" />
                <DataGridTextColumn Header="内容" Binding="{Binding Description}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="検出" Binding="{Binding Count}" IsReadOnly="True" Width="70" />
                <DataGridTextColumn Header="修正可" Binding="{Binding FixableCount}" IsReadOnly="True" Width="70" />
                <DataGridTextColumn Header="保留" Binding="{Binding HoldCount}" IsReadOnly="True" Width="60" />
              </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1" Padding="0,8" BorderBrush="#DDDDDD" BorderThickness="0,1,0,1" Margin="0,4">
              <DockPanel>
                <Button DockPanel.Dock="Left" Content="チェックした項目を適用"
                        Command="{Binding ApplyCommand}" Padding="12,4" Margin="0,0,8,0" FontWeight="Bold" />
                <Button DockPanel.Dock="Left" Content="CSV出力"
                        Command="{Binding ExportCsvCommand}" Padding="12,4" Margin="0,0,8,0"
                        ToolTip="明細と集計の 2 ファイルを書き出します" />
                <Button DockPanel.Dock="Left" Content="選択行を辞書に追加"
                        Command="{Binding AddSelectedChangeToDictionaryCommand}" Padding="12,4" Margin="0,0,12,0"
                        ToolTip="修正案を出せなかった行を辞書に登録して再検査します" />
                <TextBlock Text="{Binding InspectionSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
              </DockPanel>
            </Border>

            <!-- 適用で問題が起きた項目。不一致が 1 件でもあれば必ず見せる（docs/SPEC.md 9章） -->
            <ItemsControl Grid.Row="2"
                          ItemsSource="{Binding ApplyIssues}"
                          MaxHeight="120"
                          Background="#FFF0F0"
                          Margin="0,0,0,4"
                          Visibility="{Binding ApplyIssues.Count, Converter={StaticResource CountToVisibility}}">
              <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,6">
                    <ItemsPresenter />
                  </ScrollViewer>
                </ControlTemplate>
              </ItemsControl.Template>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#A00000" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 下段: 差分プレビュー。根拠列を必ず持つ（docs/SPEC.md 5.3） -->
            <DataGrid Grid.Row="3"
                      ItemsSource="{Binding InspectionChanges}"
                      SelectedItem="{Binding SelectedChange}"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      EnableRowVirtualization="True"
                      GridLinesVisibility="Horizontal">

              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                  <Style.Triggers>
                    <!-- 判定区分で色を変える（確定 / 要確認 / 保留） -->
                    <DataTrigger Binding="{Binding Classification}" Value="確定">
                      <Setter Property="Background" Value="#EAF7EA" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Classification}" Value="要確認">
                      <Setter Property="Background" Value="#FFF6E5" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Classification}" Value="保留">
                      <Setter Property="Background" Value="#EDEDED" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.RowStyle>

              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="適用" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                <DataGridTextColumn Header="区分" Binding="{Binding Classification}" IsReadOnly="True" Width="60" />
                <DataGridTextColumn Header="パス" Binding="{Binding RelativePath}" IsReadOnly="True" Width="280" />
                <DataGridTextColumn Header="タグ" Binding="{Binding Field}" IsReadOnly="True" Width="100" />
                <DataGridTextColumn Header="変更前" Binding="{Binding BeforeText}" IsReadOnly="True" Width="200" />
                <DataGridTextColumn Header="変更後" Binding="{Binding AfterText}" IsReadOnly="True" Width="200" />
                <DataGridTextColumn Header="根拠" Binding="{Binding Rationale}" IsReadOnly="True" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <!-- 辞書に無い値。docs/SPEC.md 7.3 が「最も使用頻度が高い」とする導線 -->
        <TabItem Header="辞書に無い値">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="0,8" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Margin="0,0,0,4">
              <DockPanel>
                <Button DockPanel.Dock="Left" Content="辞書に追加"
                        Command="{Binding AddUnknownValueToDictionaryCommand}"
                        Padding="12,4" Margin="0,0,12,0" FontWeight="Bold" />
                <TextBlock Text="{Binding UnknownValueSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
              </DockPanel>
            </Border>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding UnknownValues}"
                      SelectedItem="{Binding SelectedUnknownValue}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserSortColumns="True"
                      GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="件数" Binding="{Binding Count}" Width="60" />
                <DataGridTextColumn Header="値" Binding="{Binding Value}" Width="280" />
                <DataGridTextColumn Header="登録先" Binding="{Binding CategoryText}" Width="80" />
                <DataGridTextColumn Header="フィールド" Binding="{Binding FieldsText}" Width="150" />
                <DataGridTextColumn Header="ルール" Binding="{Binding RuleIdsText}" Width="80" />
                <DataGridTextColumn Header="代表ファイル" Binding="{Binding SampleRelativePath}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <TabItem Header="ファイル一覧">
          <DataGrid ItemsSource="{Binding Tracks}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserSortColumns="True"
                    EnableRowVirtualization="True"
                    EnableColumnVirtualization="True"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    SelectionMode="Extended">

            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Setter Property="ToolTip" Value="{Binding SplitValueSummary}" />
                <Style.Triggers>
                  <!-- 複数値として格納されている行は、表示上は連結されて見えるため色で区別する -->
                  <DataTrigger Binding="{Binding HasSplitValues}" Value="True">
                    <Setter Property="Background" Value="#FFF6E5" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
              <DataGridTextColumn Header="ファイル" Binding="{Binding FileName}" Width="220" />
              <DataGridTextColumn Header="フォルダ" Binding="{Binding FolderPath}" Width="200" />
              <DataGridTextColumn Header="形式" Binding="{Binding Format}" Width="60" />
              <DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="240" />
              <DataGridTextColumn Header="作曲家" Binding="{Binding Composer}" Width="160" />
              <DataGridTextColumn Header="アーティスト" Binding="{Binding Artist}" Width="160" />
              <DataGridTextColumn Header="指揮者" Binding="{Binding Conductor}" Width="160" />
              <DataGridTextColumn Header="アルバムアーティスト" Binding="{Binding AlbumArtist}" Width="200" />
              <DataGridTextColumn Header="アルバム" Binding="{Binding Album}" Width="220" />
              <DataGridTextColumn Header="ジャンル" Binding="{Binding Genre}" Width="80" />
              <DataGridTextColumn Header="年" Binding="{Binding Date}" Width="60" />
              <DataGridTextColumn Header="トラック" Binding="{Binding TrackNumber}" Width="70" />
              <DataGridTextColumn Header="ディスク" Binding="{Binding DiscNumber}" Width="70" />
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>

        <!-- 辞書（docs/SPEC.md 7.3） -->
        <TabItem Header="辞書" DataContext="{Binding Dictionary}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ツールバー -->
            <StackPanel Grid.Row="0" Margin="0,0,0,6">
              <DockPanel>
                <Button DockPanel.Dock="Left" Content="保存" Command="{Binding SaveCommand}"
                        Padding="12,4" Margin="0,0,8,0" FontWeight="Bold" />
                <Button DockPanel.Dock="Left" Content="検証だけ実行" Command="{Binding ValidateCommand}"
                        Padding="12,4" Margin="0,0,8,0" />
                <Button DockPanel.Dock="Left" Content="編集を破棄" Command="{Binding RevertCommand}"
                        Padding="12,4" Margin="0,0,8,0" />
                <Button DockPanel.Dock="Left" Content="既定辞書として書き出し" Command="{Binding ExportCommand}"
                        Padding="12,4" Margin="0,0,12,0"
                        ToolTip="リポジトリ同梱の default-dictionary.json へ書き戻します" />
                <TextBlock DockPanel.Dock="Right" Text="● 未保存" Foreground="#C05000" VerticalAlignment="Center"
                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="4" Margin="0,0,12,0" MinWidth="200"
                         ToolTip="正規形・別名・実体 ID で絞り込む" />
              </DockPanel>

              <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#333333" />
              <TextBlock Text="{Binding FilePath}" Margin="0,2,0,0" Foreground="#888888" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <TabControl Grid.Row="1">

              <!-- 作曲家 -->
              <TabItem Header="作曲家">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" MinWidth="160" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                      <Button Content="追加" Command="{Binding AddComposerCommand}" Padding="10,3" Margin="0,0,6,0" />
                      <Button Content="削除" Command="{Binding RemoveComposerCommand}" Padding="10,3" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Composers}" SelectedItem="{Binding SelectedComposer}"
                             DisplayMemberPath="Canonical" />
                  </DockPanel>

                  <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#EEEEEE" />

                  <Grid Grid.Column="2" Margin="8,0,0,0">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="正規形" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBox Grid.Row="1" Padding="4"
                             Text="{Binding SelectedComposer.Canonical, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" Text="別名（1 行 1 件）" FontWeight="Bold" Margin="0,10,0,4" />
                    <TextBox Grid.Row="3" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Text="{Binding SelectedComposer.AliasesText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="4" Text="日本語表記（1 行 1 件）" FontWeight="Bold" Margin="0,10,0,4" />
                    <TextBox Grid.Row="5" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Text="{Binding SelectedComposer.AliasesJaText, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                </Grid>
              </TabItem>

              <!-- 人物 -->
              <TabItem Header="人物">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" MinWidth="160" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                      <Button Content="追加" Command="{Binding AddPersonCommand}" Padding="10,3" Margin="0,0,6,0" />
                      <Button Content="削除" Command="{Binding RemovePersonCommand}" Padding="10,3" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Persons}" SelectedItem="{Binding SelectedPerson}"
                             DisplayMemberPath="Canonical" />
                  </DockPanel>

                  <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#EEEEEE" />

                  <Grid Grid.Column="2" Margin="8,0,0,0">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="正規形" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBox Grid.Row="1" Padding="4"
                             Text="{Binding SelectedPerson.Canonical, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                      <CheckBox Content="指揮者" IsChecked="{Binding SelectedPerson.IsConductor}" Margin="0,0,16,0" />
                      <CheckBox Content="ソリスト" IsChecked="{Binding SelectedPerson.IsSoloist}" />
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="別名（1 行 1 件）" FontWeight="Bold" Margin="0,10,0,4" />
                    <TextBox Grid.Row="4" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Text="{Binding SelectedPerson.AliasesText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="5" Text="日本語表記（1 行 1 件）" FontWeight="Bold" Margin="0,10,0,4" />
                    <TextBox Grid.Row="6" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Text="{Binding SelectedPerson.AliasesJaText, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                </Grid>
              </TabItem>

              <!-- 団体 -->
              <TabItem Header="団体">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" MinWidth="160" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                      <Button Content="追加" Command="{Binding AddEnsembleCommand}" Padding="10,3" Margin="0,0,6,0" />
                      <Button Content="削除" Command="{Binding RemoveEnsembleCommand}" Padding="10,3" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Ensembles}" SelectedItem="{Binding SelectedEnsemble}"
                             DisplayMemberPath="DisplayName" />
                  </DockPanel>

                  <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#EEEEEE" />

                  <ScrollViewer Grid.Column="2" Margin="8,0,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                      <TextBlock Text="実体 ID（改名をまたいで同一の団体を指す。名前の類似で束ねないこと）"
                                 FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap" />
                      <TextBox Padding="4"
                               Text="{Binding SelectedEnsemble.EntityId, UpdateSourceTrigger=PropertyChanged}" />

                      <TextBlock Text="正規形（時代分割しない場合）" FontWeight="Bold" Margin="0,10,0,4" />
                      <TextBox Padding="4"
                               Text="{Binding SelectedEnsemble.Canonical, UpdateSourceTrigger=PropertyChanged}" />

                      <CheckBox Content="時代分割を行わない（個別例外。TAGGING_POLICY 5.3.2）"
                                IsChecked="{Binding SelectedEnsemble.NoEraSplit}" Margin="0,8,0,0" />

                      <DockPanel Margin="0,12,0,4">
                        <Button DockPanel.Dock="Right" Content="区分を削除" Command="{Binding RemoveEraCommand}" Padding="8,2" />
                        <Button DockPanel.Dock="Right" Content="区分を追加" Command="{Binding AddEraCommand}" Padding="8,2" Margin="0,0,6,0" />
                        <TextBlock Text="時代分割（収録時点の名称を採用する。TAGGING_POLICY 5.3.1）" FontWeight="Bold" VerticalAlignment="Center" />
                      </DockPanel>
                      <DataGrid ItemsSource="{Binding SelectedEnsemble.Eras}"
                                SelectedItem="{Binding SelectedEra}"
                                AutoGenerateColumns="False"
                                SelectionMode="Single"
                                MaxHeight="160"
                                GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="この年以降" Binding="{Binding FromText, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                          <DataGridTextColumn Header="この年より前" Binding="{Binding UntilText, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                          <DataGridTextColumn Header="正規形" Binding="{Binding Canonical, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        </DataGrid.Columns>
                      </DataGrid>

                      <TextBlock Text="別名（1 行 1 件）" FontWeight="Bold" Margin="0,12,0,4" />
                      <TextBox Height="90" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                               Text="{Binding SelectedEnsemble.AliasesText, UpdateSourceTrigger=PropertyChanged}" />

                      <TextBlock Text="日本語表記（1 行 1 件）" FontWeight="Bold" Margin="0,10,0,4" />
                      <TextBox Height="90" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                               Text="{Binding SelectedEnsemble.AliasesJaText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </TabItem>

              <!-- 誤記 -->
              <TabItem Header="誤記">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="追加" Command="{Binding AddTypoCommand}" Padding="10,3" Margin="0,0,6,0" />
                    <Button Content="削除" Command="{Binding RemoveTypoCommand}" Padding="10,3" Margin="0,0,12,0" />
                    <TextBlock VerticalAlignment="Center" Foreground="#666666" TextWrapping="Wrap"
                               Text="照合は正規表現で行う。団体名には適用しない（Münchener Bach-Chor の -ener は正しい表記）。" />
                  </StackPanel>

                  <DataGrid Grid.Row="1"
                            ItemsSource="{Binding Typos}"
                            SelectedItem="{Binding SelectedTypo}"
                            AutoGenerateColumns="False"
                            SelectionMode="Single"
                            GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="パターン" Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Width="240" />
                      <DataGridTextColumn Header="置換後" Binding="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                      <DataGridTextColumn Header="メモ" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                      <DataGridTextColumn Header="正規表現" Binding="{Binding ValidityMark}" IsReadOnly="True" Width="80" />
                    </DataGrid.Columns>
                  </DataGrid>

                  <!-- その場で試せるテスト欄（docs/SPEC.md 7.3） -->
                  <Border Grid.Row="2" Padding="8" Margin="0,6,0,0" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="1">
                    <StackPanel>
                      <TextBlock Text="選択中のパターンを試す" FontWeight="Bold" Margin="0,0,0,4" />
                      <TextBox Padding="4" Text="{Binding TypoTestInput, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBlock Text="{Binding TypoTestResult}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#333333" />
                    </StackPanel>
                  </Border>
                </Grid>
              </TabItem>

              <!-- 保護対象 -->
              <TabItem Header="保護対象">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <StackPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock TextWrapping="Wrap" Foreground="#666666"
                               Text="配役情報を含むため書き換えない albumartist（TAGGING_POLICY 2.3）。ここに載っている値は全ルールの検査前に除外される。" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                      <Button Content="追加" Command="{Binding AddProtectedValueCommand}" Padding="10,3" Margin="0,0,6,0" />
                      <Button Content="削除" Command="{Binding RemoveProtectedValueCommand}" Padding="10,3" />
                    </StackPanel>
                  </StackPanel>

                  <ListBox Grid.Row="1"
                           ItemsSource="{Binding ProtectedValues}"
                           SelectedItem="{Binding SelectedProtectedValue}"
                           DisplayMemberPath="Value"
                           HorizontalContentAlignment="Stretch" />

                  <StackPanel Grid.Row="2" Margin="0,6,0,0">
                    <TextBlock Text="選択中の値" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBox Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="{Binding SelectedProtectedValue.Value, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
              </TabItem>

            </TabControl>

            <!-- 検証結果。エラーは保存を止める -->
            <ItemsControl Grid.Row="2"
                          ItemsSource="{Binding Issues}"
                          MaxHeight="130"
                          Margin="0,6,0,0"
                          Background="#FFF7F0"
                          Visibility="{Binding Issues.Count, Converter={StaticResource CountToVisibility}}">
              <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,6">
                    <ItemsPresenter />
                  </ScrollViewer>
                </ControlTemplate>
              </ItemsControl.Template>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#8A4B00" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </TabItem>

        <TabItem Header="バックアップ履歴">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="180" MinHeight="100" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Backups}"
                      SelectedItem="{Binding SelectedBackup}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="取得日時" Binding="{Binding CreatedAtText}" Width="160" />
                <DataGridTextColumn Header="理由" Binding="{Binding ReasonText}" Width="120" />
                <DataGridTextColumn Header="件数" Binding="{Binding TrackCountText}" Width="80" />
                <DataGridTextColumn Header="補足" Binding="{Binding Note}" Width="200" />
                <DataGridTextColumn Header="フォルダ" Binding="{Binding DirectoryPath}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1" Padding="0,8" BorderBrush="#DDDDDD" BorderThickness="0,1,0,1" Margin="0,4">
              <DockPanel>
                <Button DockPanel.Dock="Left" Content="差分を確認"
                        Command="{Binding PreviewRestoreCommand}" Padding="12,4" Margin="0,0,8,0" />
                <Button DockPanel.Dock="Left" Content="選択した項目を復元"
                        Command="{Binding RestoreCommand}" Padding="12,4" Margin="0,0,12,0" />
                <TextBlock Text="{Binding RestoreSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
              </DockPanel>
            </Border>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding RestoreItems}"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="戻す" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                <DataGridTextColumn Header="パス" Binding="{Binding RelativePath}" IsReadOnly="True" Width="300" />
                <DataGridTextColumn Header="フィールド" Binding="{Binding Field}" IsReadOnly="True" Width="110" />
                <DataGridTextColumn Header="現在の値" Binding="{Binding CurrentText}" IsReadOnly="True" Width="260" />
                <DataGridTextColumn Header="戻す値" Binding="{Binding SnapshotText}" IsReadOnly="True" Width="260" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <TabItem Header="読み取り失敗">
          <DataGrid ItemsSource="{Binding Failures}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="パス" Binding="{Binding RelativePath}" Width="400" />
              <DataGridTextColumn Header="内容" Binding="{Binding Message}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>

      </TabControl>
    </Grid>
  </DockPanel>
</Window>
