<Window x:Class="MusicTagger.App.MergeDictionaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="既定辞書から取り込む" Height="600" Width="820"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <DockPanel Margin="12">

    <Border DockPanel.Dock="Top" Padding="10" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="{Binding Header}" FontWeight="Bold" TextWrapping="Wrap" />
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#555555"
                   Text="利用者辞書は初回起動時にコピーされたきり更新されません。アプリ側に追加されたエントリや設定はここから取り込みます。" />
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#7A5A00"
                   Text="意図的に削除したエントリが含まれている場合は、その行のチェックを外してください。取り込みは追加だけを行い、編集済みの正規形は上書きしません。" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Left" Content="すべて選択" Click="OnSelectAll" Padding="12,4" Margin="0,0,6,0" />
        <Button DockPanel.Dock="Left" Content="すべて解除" Click="OnSelectNone" Padding="12,4" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="取り込んで保存" Click="OnAccept" Padding="16,6" Margin="0,0,8,0" IsDefault="True" FontWeight="Bold" />
          <Button Content="キャンセル" Click="OnCancel" Padding="16,6" IsCancel="True" />
        </StackPanel>
      </DockPanel>
    </Border>

    <DataGrid ItemsSource="{Binding Items}"
              AutoGenerateColumns="False"
              CanUserSortColumns="True"
              GridLinesVisibility="Horizontal"
              Margin="0,12,0,0">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="取り込む" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="70" />
        <DataGridTextColumn Header="種別" Binding="{Binding Category}" IsReadOnly="True" Width="70" />
        <DataGridTextColumn Header="内容" Binding="{Binding Summary}" IsReadOnly="True" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
