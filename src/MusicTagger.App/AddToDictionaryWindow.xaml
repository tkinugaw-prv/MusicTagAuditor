<Window x:Class="MusicTagger.App.AddToDictionaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MusicTagger.App.Converters"
        Title="辞書に追加" Height="560" Width="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:InverseBooleanConverter x:Key="InverseBool" />
    <conv:EnumToBooleanConverter x:Key="EnumToBool" />
    <conv:EnumToVisibilityConverter x:Key="EnumToVisibility" />
  </Window.Resources>

  <DockPanel Margin="12">

    <!-- 対象の値 -->
    <Border DockPanel.Dock="Top" Padding="10" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="{Binding Header}" FontWeight="Bold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding SamplePath}" Foreground="#666666" TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <!-- 注意書き。原則との齟齬をここで気づけるようにする -->
    <Border DockPanel.Dock="Top" Padding="10" Background="#FFF6E5" BorderBrush="#E8D7B0" BorderThickness="1" Margin="0,8,0,0">
      <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="#7A5A00" />
    </Border>

    <!-- 実行ボタン -->
    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="辞書に追加して再検査" Click="OnAccept" Padding="16,6" Margin="0,0,8,0" IsDefault="True" FontWeight="Bold" />
        <Button Content="キャンセル" Click="OnCancel" Padding="16,6" IsCancel="True" />
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
      <StackPanel>

        <TextBlock Text="種別" FontWeight="Bold" Margin="0,0,0,4" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <RadioButton Content="作曲家" GroupName="Category" Margin="0,0,16,0"
                       IsChecked="{Binding Category, Converter={StaticResource EnumToBool}, ConverterParameter=Composer}" />
          <RadioButton Content="人物（指揮者・ソリスト）" GroupName="Category" Margin="0,0,16,0"
                       IsChecked="{Binding Category, Converter={StaticResource EnumToBool}, ConverterParameter=Person}" />
          <RadioButton Content="演奏団体" GroupName="Category"
                       IsChecked="{Binding Category, Converter={StaticResource EnumToBool}, ConverterParameter=Ensemble}" />
        </StackPanel>

        <TextBlock Text="登録のしかた" FontWeight="Bold" Margin="0,0,0,4" />
        <RadioButton Content="既にあるエントリの別名にする" GroupName="Mode" IsChecked="{Binding AddsToExisting}" />
        <RadioButton Content="新しいエントリを作る" GroupName="Mode"
                     IsChecked="{Binding AddsToExisting, Converter={StaticResource InverseBool}}"
                     Margin="0,4,0,8" />

        <!-- 既存エントリに足す -->
        <StackPanel Visibility="{Binding AddsToExisting, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="足す先の正規形" Margin="0,8,0,4" />
          <TextBox Text="{Binding CanonicalFilter, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="絞り込み" Padding="4" Margin="0,0,0,4" />
          <ListBox ItemsSource="{Binding Canonicals}"
                   SelectedItem="{Binding SelectedCanonical}"
                   Height="220" />
        </StackPanel>

        <!-- 新しいエントリを作る -->
        <StackPanel Visibility="{Binding AddsToExisting, Converter={StaticResource InverseBoolToVisibility}}">
          <TextBlock Text="正規形" Margin="0,8,0,4" />
          <TextBox Text="{Binding NewCanonical, UpdateSourceTrigger=PropertyChanged}" Padding="4" />

          <StackPanel Visibility="{Binding Category, Converter={StaticResource EnumToVisibility}, ConverterParameter=Ensemble}">
            <TextBlock Text="実体 ID（改名をまたいで同一の団体を指す）" Margin="0,8,0,4" />
            <TextBox Text="{Binding NewEntityId, UpdateSourceTrigger=PropertyChanged}" Padding="4" />
          </StackPanel>

          <StackPanel Visibility="{Binding Category, Converter={StaticResource EnumToVisibility}, ConverterParameter=Person}">
            <TextBlock Text="役割" Margin="0,8,0,4" />
            <StackPanel Orientation="Horizontal">
              <CheckBox Content="指揮者" IsChecked="{Binding IsConductor}" Margin="0,0,16,0" />
              <CheckBox Content="ソリスト" IsChecked="{Binding IsSoloist}" />
            </StackPanel>
          </StackPanel>

          <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#666666"
                     Text="タグに入っている値は別名として自動で登録されます。正規形と同じ場合は重複しません。" />
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
